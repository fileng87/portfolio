# Copy to .env.local and fill in the values

# Email registered on Gravatar, used for the hero avatar (hashed on the server, never sent to the client)
GRAVATAR_EMAIL=

# Repositories shown under Work, in order: comma-separated "owner/name"
GITHUB_REPOS=
# Personal access token; read-only public access is enough (the GraphQL API requires a token)
GITHUB_TOKEN=

# Channel whose videos are shown (starts with "UC"; YouTube → Settings → Advanced settings)
YOUTUBE_CHANNEL_ID=
# Optional video id (the "v" in youtube.com/watch?v=...) shown large first; defaults to the latest upload
YOUTUBE_FEATURED_VIDEO=
